# ============================================================================
# TradeOffStackAPI — Production environment template
# Copy to `.env` (NEVER commit `.env` — it is gitignored) and fill the values.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=tradeoff_admin
POSTGRES_PASSWORD=<strong-random-password>

# --- JWT signing key (min 32 chars, mapped to Jwt:Key in the app) ---
JWT_SECRET_KEY=<strong-random-secret-min-64-chars>

# --- Cloudflare R2 (bucket tradeoffstack-assets) ---
# Create fresh keys in the Cloudflare dashboard (R2 > Manage R2 API tokens).
# The keys previously committed to appsettings.json MUST be revoked.
R2_ACCESS_KEY=<r2-access-key>
R2_SECRET_KEY=<r2-secret-key>

# --- Optional: initial seed account passwords (min 12 chars) ---
# If unset, a secure random password is generated ONCE at first startup
# and printed in the logs. Change it immediately after first login.
# SEED_ADMIN_PASSWORD=
# SEED_TESTER_PASSWORD=
